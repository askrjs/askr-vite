{
  "name": "@askrjs/vite",
  "version": "0.0.5",
  "description": "Vite plugin for Askr JSX and template transforms",
  "homepage": "https://github.com/askrjs/askr-vite#readme",
  "bugs": {
    "url": "https://github.com/askrjs/askr-vite/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "askrjs",
    "url": "https://github.com/askrjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askrjs/askr-vite.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "npm run test:unit && npm run test:jsdom && npm run test:browser",
    "test:unit": "vp test run -c vitest.config.ts",
    "test:jsdom": "npm run test:unit",
    "test:browser": "npm run test:unit",
    "fmt": "vp fmt .",
    "lint": "vp lint .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@askrjs/node": ">=0.0.1 <0.1.0",
    "@askrjs/server": ">=0.0.1 <0.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plus": "^0.1.24"
  },
  "peerDependencies": {
    "@askrjs/askr": ">=0.0.30 <0.1.0",
    "@askrjs/node": ">=0.0.1 <0.1.0",
    "@askrjs/server": ">=0.0.1 <0.1.0",
    "vite": "^8.0.1"
  },
  "peerDependenciesMeta": {
    "@askrjs/node": {
      "optional": true
    },
    "@askrjs/server": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
