{
  "name": "@askrjs/vite",
  "version": "0.0.9",
  "description": "Vite plugin for Askr JSX and template transforms",
  "homepage": "https://github.com/askrjs/askr-vite#readme",
  "bugs": {
    "url": "https://github.com/askrjs/askr-vite/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "askrjs",
    "url": "https://github.com/askrjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askrjs/askr-vite.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "npm run test:unit",
    "test:unit": "vp test run -c vitest.config.ts",
    "test:publint": "publint",
    "fmt": "vp fmt .",
    "lint": "vp lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "node tests/package-artifacts.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:publint && npm run pack:check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@askrjs/node": ">=0.0.1 <0.1.0",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@askrjs/askr": ">=0.0.52 <0.1.0",
    "@askrjs/server": ">=0.0.1 <0.1.0",
    "@types/node": "^26.0.0",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plus": "^0.2.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@askrjs/askr": ">=0.0.52 <0.1.0",
    "vite": "^8.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
